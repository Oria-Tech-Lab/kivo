# ============================================================
# KIVO — Variables de entorno requeridas
# Copiar a .env.local y completar con valores reales
# NUNCA commitear .env.local al repositorio
# ============================================================

# ── Supabase (pública — va al bundle del navegador) ─────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Supabase (privada — solo server-side) ───────────────────
# NUNCA usar en Client Components ni exponer como NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Resend (correos transaccionales) ────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@kivo.pe

# ── RUC Lookup — apiperu.dev ─────────────────────────────────
APIPERU_API_KEY=

# ── Upstash Redis (rate limiting) ────────────────────────────
UPSTASH_REDIS_URL=https://xxxxxxxxxxxxxxxxxxxx.upstash.io
UPSTASH_REDIS_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ── Cifrado de datos sensibles (pgcrypto) ────────────────────
# Generar con: openssl rand -hex 32
DB_ENCRYPTION_KEY=

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Fase 2+: Monitoring ──────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
